# Copier ce fichier en .streamlit/secrets.toml (en local)
# ou coller son contenu dans Settings > Secrets (Streamlit Community Cloud).
# Ne jamais publier le vrai fichier secrets.toml.

sheet_id = "ID-DU-GOOGLE-SHEET"   # partie de l URL entre /d/ et /edit
# Envoi des photos : adresse de l'application web du script apps_script/Code.gs (README, « Photos »)
# et secret partagé (même valeur que la propriété SECRET du script).
photos_url = "https://script.google.com/macros/s/.../exec"
photos_secret = "UNE-LONGUE-CHAINE-ALEATOIRE"

[gcp_service_account]
type = "service_account"
project_id = "VOTRE-PROJET"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "enrolement-eariary@VOTRE-PROJET.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
